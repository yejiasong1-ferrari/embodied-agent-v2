# Never commit the real key. Export these variables in Terminal instead.
DASHSCOPE_API_KEY=replace_with_a_new_key
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_MODEL=qwen3-vl-plus

# required: 没有 LLM 或 LLM 审核失败就安全停止，不伪装成在用 LLM。
# auto: 在线 LLM 失败时允许显式的本地安全回退。
# offline: 只用于无网络开发和回归测试。
EMBODIED_AGENT_MODE=required

# 腕部广角相机；本地视觉保留 640x480，发给 VLM 的是最多两张 320px 缩略图。
WRIST_CAMERA_FOVY_DEG=95
